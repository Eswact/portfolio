---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { defaultLang, languages, localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Locale-neutral path of this page, e.g. '/' or '/work/fibi'. */
  path: string;
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { lang, path, title, description, noindex = false } = Astro.props;
const t = useTranslations(lang);
const pageTitle = title ? `${title} — ${profile.name}` : t('meta.title');
const pageDescription = description ?? t('meta.description');
const canonical = new URL(localePath(lang, path), Astro.site);
const alternates = (Object.keys(languages) as Lang[]).map((l) => ({
  lang: l,
  href: new URL(localePath(l, path), Astro.site).href,
}));

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: lang === 'tr' ? 'Yazılım Geliştirici' : 'Software Developer',
  email: `mailto:${profile.email}`,
  url: new URL(localePath(lang, '/'), Astro.site).href,
  address: { '@type': 'PostalAddress', addressLocality: 'Istanbul', addressCountry: 'TR' },
  sameAs: [profile.github, profile.linkedin],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={new URL(localePath(defaultLang, path), Astro.site).href} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#f5f5f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#121213" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      try {
        const root = document.documentElement;
        const theme = localStorage.getItem('theme');
        if (theme === 'dark' || theme === 'light') root.dataset.theme = theme;
        // Karar 11 — the curtain plays once per tab session, never with reduced motion.
        // It starts only when the tab is actually visible (a tab opened in the background waits),
        // on the next frame, so the visitor always sees it from the first beat.
        if (!sessionStorage.getItem('intro') && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
          sessionStorage.setItem('intro', '1');
          root.classList.add('intro');
          const go = () =>
            requestAnimationFrame(() =>
              requestAnimationFrame(() => {
                root.classList.add('intro-go');
                dispatchEvent(new Event('intro:go'));
              }),
            );
          if (document.visibilityState === 'visible') go();
          else
            document.addEventListener('visibilitychange', function wait() {
              if (document.visibilityState !== 'visible') return;
              document.removeEventListener('visibilitychange', wait);
              go();
            });
        }
      } catch {}

      // Page-to-page: only the project being opened (or left) carries its title across.
      // [data-vt] holds the case-study path a title belongs to.
      const vtName = (el, done) => {
        if (!el) return;
        el.style.viewTransitionName = 'project-title';
        done.finally(() => (el.style.viewTransitionName = ''));
      };
      const vtFind = (path) => path && document.querySelector('[data-vt="' + path + '"]');
      addEventListener('pageswap', (e) => {
        if (!e.viewTransition || !e.activation) return;
        const to = new URL(e.activation.entry.url).pathname;
        vtName(vtFind(to) || vtFind(location.pathname), e.viewTransition.finished);
      });
      addEventListener('pagereveal', (e) => {
        if (!e.viewTransition) return;
        const from = navigation.activation && navigation.activation.from && new URL(navigation.activation.from.url).pathname;
        const own = () => vtFind(location.pathname) || vtFind(from);
        // The page is still parsing when pagereveal fires on some loads; wait for the DOM if needed.
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', () => vtName(own(), e.viewTransition.finished), { once: true });
        else vtName(own(), e.viewTransition.finished);
      });
    </script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <Font cssVariable="--font-schibsted" preload />
    <Font cssVariable="--font-jetbrains" preload />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip" href="#main">{t('nav.skip')}</a>
    <Intro />
    <div class="page">
      <Header lang={lang} path={path} />
      <main id="main">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>

<style>
  .skip {
    position: absolute;
    left: var(--gutter);
    top: -100px;
    padding: 8px 12px;
    background: var(--fg);
    color: var(--bg);
    z-index: 60;
  }

  .skip:focus {
    top: 8px;
  }

  .page {
    display: grid;
    grid-template-rows: auto 1fr auto;
    min-height: 100vh;
    min-height: 100svh;
  }
</style>
