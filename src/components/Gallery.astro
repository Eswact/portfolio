---
// Karar 09 — Vitrin: one device on a lit stage, a quiet list beside it. Choosing a screen cross-fades it
// inside the same device. Language is picked at build time, theme by CSS (the hidden variant is never fetched).
import { Picture } from 'astro:assets';
import type { GallerySurface } from '../data/cases';
import { resolveShot } from '../data/shots';
import { useTranslations, type Lang } from '../i18n/ui';

interface Props {
  surfaces: GallerySurface[];
  lang: Lang;
}

const { surfaces, lang } = Astro.props;
const t = useTranslations(lang);
const pad = (n: number) => String(n).padStart(2, '0');

const sizes = {
  phone: '(min-width: 900px) 284px, 214px',
  browser: '(min-width: 1360px) 1060px, 84vw',
  screen: '(min-width: 1360px) 1040px, 82vw',
};
const widths = {
  phone: [214, 320, 400, 568, 852],
  browser: [480, 720, 1060, 1280, 1590, 2120],
  screen: [480, 720, 1040, 1280, 1560, 2080],
};
---

<div class="vitrin" data-vitrin>
  {
    surfaces.length > 1 && (
      <div class="surfaces" role="group" aria-label={t('work.screens')}>
        {surfaces.map((s, i) => (
          <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} data-surface-btn={s.id}>
            {s.label[lang]}
          </button>
        ))}
      </div>
    )
  }

  {
    surfaces.map((s, si) => (
      <div class:list={['stage', s.device]} data-surface={s.id} hidden={si > 0}>
        <div class="device">
          {s.device === 'browser' && (
            <span class="bar mono" aria-hidden="true">
              <i />
              <i />
              <i />
              <span>{s.address}</span>
            </span>
          )}
          <button class="view" type="button" data-zoom aria-label={t('work.zoom')}>
            {s.shots.map((shot, i) => {
              const img = resolveShot(shot.key, lang);
              const themed = img.dark && img.dark !== img.light;
              const common = {
                alt: shot.alt[lang],
                formats: ['avif', 'webp'] as ('avif' | 'webp')[],
                fallbackFormat: 'webp' as const,
                widths: widths[s.device],
                sizes: sizes[s.device],
                loading: 'lazy' as const,
                decoding: 'async' as const,
              };
              return (
                <span class:list={['shot', { 'show on': i === 0 }]} data-shot={i}>
                  <Picture src={img.light} {...common} pictureAttributes={{ class: themed ? 'v v-light' : img.dark ? 'v' : 'v dim' }} />
                  {themed && <Picture src={img.dark!} {...common} pictureAttributes={{ class: 'v v-dark' }} />}
                </span>
              );
            })}
          </button>
        </div>

        <div class="copy">
          <div class="now" aria-live="polite">
            <span class="mono muted num" data-count>
              {pad(1)} / {pad(s.shots.length)}
            </span>
            <h3 data-title>{s.shots[0].caption[lang]}</h3>
            <p class="muted" data-note>
              {s.shots[0].note[lang]}
            </p>
          </div>
          {s.shots.length > 1 && (
            <ul class="list" role="list">
              {s.shots.map((shot, i) => (
                <li>
                  <button
                    type="button"
                    aria-pressed={i === 0 ? 'true' : 'false'}
                    data-pick={i}
                    data-caption={shot.caption[lang]}
                    data-note={shot.note[lang]}
                  >
                    <span class="mono num">{pad(i + 1)}</span>
                    <span>{shot.caption[lang]}</span>
                    <span class="tick" aria-hidden="true" />
                  </button>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
    ))
  }

  <p class="note mono muted">{t('work.real')}</p>

  <dialog class="lightbox" data-lightbox aria-label={t('work.screens')}>
    <div class="big" data-big></div>
    <button type="button" class="close mono" data-close>{t('work.close')}</button>
  </dialog>
</div>

<script>
  // Biggest candidate of a <picture>, for the lightbox.
  function largest(picture: HTMLPictureElement) {
    const set = picture.querySelector('source')?.srcset ?? picture.querySelector('img')?.srcset ?? '';
    return set.split(',').pop()?.trim().split(' ')[0] || picture.querySelector('img')!.currentSrc;
  }

  document.querySelectorAll<HTMLElement>('[data-vitrin]').forEach((root) => {
    const stages = [...root.querySelectorAll<HTMLElement>('[data-surface]')];
    const surfaceButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-surface-btn]')];

    surfaceButtons.forEach((button) =>
      button.addEventListener('click', () => {
        surfaceButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        stages.forEach((stage) => (stage.hidden = stage.dataset.surface !== button.dataset.surfaceBtn));
      }),
    );

    stages.forEach((stage) => {
      const shots = [...stage.querySelectorAll<HTMLElement>('[data-shot]')];
      const picks = [...stage.querySelectorAll<HTMLButtonElement>('[data-pick]')];
      const count = stage.querySelector('[data-count]')!;
      const title = stage.querySelector('[data-title]')!;
      const note = stage.querySelector('[data-note]')!;
      const total = String(shots.length).padStart(2, '0');

      let current = 0;
      picks.forEach((pick) =>
        pick.addEventListener('click', async () => {
          const i = Number(pick.dataset.pick);
          if (i === current) return;
          const prev = shots[current];
          const next = shots[i];
          current = i;
          picks.forEach((p, j) => p.setAttribute('aria-pressed', String(i === j)));
          count.textContent = `${String(i + 1).padStart(2, '0')} / ${total}`;
          title.textContent = pick.dataset.caption!;
          note.textContent = pick.dataset.note!;
          // Only the chosen screen is ever downloaded: show it, wait for its pixels, then cross-fade.
          next.classList.add('show');
          const img = [...next.querySelectorAll('img')].find((el) => el.offsetParent !== null);
          await img?.decode().catch(() => {});
          if (current !== i) return;
          requestAnimationFrame(() => {
            next.classList.add('on');
            prev.classList.remove('on');
            setTimeout(() => !prev.classList.contains('on') && prev.classList.remove('show'), 600);
          });
        }),
      );
    });

    const dialog = root.querySelector<HTMLDialogElement>('[data-lightbox]')!;
    const big = dialog.querySelector<HTMLElement>('[data-big]')!;
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((button) =>
      button.addEventListener('click', () => {
        const visible = [...button.querySelectorAll<HTMLPictureElement>('.on picture')].find((p) => p.offsetParent !== null);
        if (!visible) return;
        const img = new Image();
        img.src = largest(visible);
        img.alt = visible.querySelector('img')!.alt;
        big.replaceChildren(img);
        dialog.showModal();
      }),
    );
    dialog.querySelector('[data-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => e.target === dialog && dialog.close());
  });
</script>

<style>
  .vitrin {
    position: relative;
    display: grid;
    gap: 16px;
  }

  /* Surface switch: quiet text, underlined when chosen. */
  .surfaces {
    position: absolute;
    top: clamp(16px, 2.4vw, 24px);
    right: clamp(20px, 3vw, 32px);
    z-index: 2;
    display: flex;
    gap: 20px;
  }

  .surfaces button {
    padding: 4px 0;
    border: 0;
    background: none;
    color: var(--muted);
    font-size: 0.9375rem;
    cursor: pointer;
    text-underline-offset: 7px;
    transition: color 0.2s;
  }

  .surfaces button:hover,
  .surfaces button[aria-pressed='true'] {
    color: var(--fg);
  }

  .surfaces button[aria-pressed='true'] {
    text-decoration: underline;
    text-decoration-thickness: 1px;
  }

  /* The stage: plinth ground, light from above, one object. */
  .stage {
    position: relative;
    display: grid;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
    padding: clamp(64px, 7vw, 96px) clamp(20px, 6vw, 88px) clamp(48px, 6vw, 80px);
    background: var(--surface);
    overflow: hidden;
    transition: background-color 0.6s var(--ease);
  }

  .stage[hidden] {
    display: none;
  }

  .stage::before {
    content: '';
    position: absolute;
    top: 0;
    height: 80%;
    pointer-events: none;
    background: radial-gradient(ellipse 50% 60% at 50% 0%, var(--glow), transparent 70%);
  }

  .phone {
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
  }

  .phone::before {
    left: 4%;
    width: 44%;
  }

  .browser,
  .screen {
    grid-template-columns: minmax(0, 1fr);
  }

  .browser::before,
  .screen::before {
    left: 15%;
    right: 15%;
  }

  .device {
    position: relative;
    justify-self: center;
    width: 100%;
  }

  /* A soft floor shadow under the object. */
  .device::after {
    content: '';
    position: absolute;
    left: 12%;
    right: 12%;
    bottom: -30px;
    height: 26px;
    background: radial-gradient(ellipse at center, rgb(0 0 0 / 0.26), transparent 70%);
    filter: blur(4px);
    pointer-events: none;
  }

  .view {
    position: relative;
    display: grid;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
    overflow: hidden;
  }

  /* Every shot shares one cell; the chosen one fades in over the others. */
  .shot {
    grid-area: 1 / 1;
    display: none;
    opacity: 0;
    transition: opacity 0.55s var(--ease);
  }

  .shot.show {
    display: block;
  }

  .shot.on {
    opacity: 1;
  }

  .shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }

  .phone .device {
    max-width: 300px;
    padding: 8px;
    border-radius: 42px;
    background: #0c0c0d;
    box-shadow:
      0 50px 80px -44px rgb(0 0 0 / 0.55),
      inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }

  .phone .view {
    border-radius: 34px;
  }

  .browser .device {
    border: 1px solid var(--line);
    background: var(--card);
    box-shadow: 0 50px 90px -56px rgb(0 0 0 / 0.5);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 32px;
    padding-inline: 14px;
    border-bottom: 1px solid var(--line);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .bar i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  .bar span {
    margin-left: 10px;
  }

  /* A TV on the wall: the case is the device. */
  .screen .device {
    padding: clamp(6px, 1vw, 12px);
    border-radius: 8px;
    background: #0c0c0d;
    box-shadow: 0 50px 90px -50px rgb(0 0 0 / 0.55);
  }

  /* Copy beside (phone) or below (web, device) the object. */
  .copy {
    display: grid;
    gap: 28px;
    align-content: center;
    min-width: 0;
  }

  .now {
    display: grid;
    gap: 10px;
    align-content: start;
  }

  .phone .now {
    min-height: 9.5em;
  }

  [data-count] {
    font-size: 0.75rem;
  }

  .now h3 {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }

  .now p {
    max-width: 42ch;
  }

  .browser .copy,
  .screen .copy {
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
    gap: 16px clamp(24px, 4vw, 56px);
  }

  .browser .now h3,
  .screen .now h3 {
    font-size: var(--step-1);
  }

  .list {
    display: grid;
    border-top: 1px solid var(--fg);
  }

  .list button {
    display: grid;
    grid-template-columns: 3ch minmax(0, 1fr) auto;
    gap: 14px;
    align-items: baseline;
    width: 100%;
    padding: 12px 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    color: var(--muted);
    font-size: 0.9375rem;
    text-align: left;
    cursor: pointer;
    transition: color 0.2s;
  }

  .list button:hover,
  .list button[aria-pressed='true'] {
    color: var(--fg);
  }

  .list .num {
    font-size: 0.75rem;
  }

  .tick {
    align-self: center;
    width: 0;
    height: 1px;
    background: var(--fg);
    transition: width 0.5s var(--ease);
  }

  [aria-pressed='true'] .tick {
    width: 40px;
  }

  .note {
    font-size: 0.6875rem;
  }

  /* Theme: show the capture that matches the page; dim captures of products without a dark mode. */
  :global(.v-dark) {
    display: none;
  }

  :global(:root[data-theme='dark']) .shot :global(.v-light) {
    display: none;
  }

  :global(:root[data-theme='dark']) .shot :global(.v-dark) {
    display: block;
  }

  :global(:root[data-theme='dark']) .shot :global(.dim img) {
    filter: brightness(0.8) contrast(1.04);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .shot :global(.v-light) {
      display: none;
    }

    :global(:root:not([data-theme='light'])) .shot :global(.v-dark) {
      display: block;
    }

    :global(:root:not([data-theme='light'])) .shot :global(.dim img) {
      filter: brightness(0.8) contrast(1.04);
    }
  }

  @media (max-width: 899px) {
    .phone,
    .browser .copy,
    .screen .copy {
      grid-template-columns: minmax(0, 1fr);
    }

    .phone .device {
      max-width: 230px;
    }

    .phone .now {
      min-height: 0;
    }

    .phone::before {
      left: 10%;
      width: 80%;
      height: 50%;
    }

    .surfaces {
      position: static;
      justify-self: start;
    }
  }

  .lightbox {
    width: min(96vw, 1600px);
    max-width: none;
    max-height: 94vh;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }

  .lightbox::backdrop {
    background: rgb(10 10 11 / 0.86);
  }

  .big :global(img) {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 86vh;
    margin-inline: auto;
  }

  .close {
    display: block;
    margin: 12px auto 0;
    height: 36px;
    padding-inline: 16px;
    border: 1px solid #ededea;
    border-radius: 99px;
    background: transparent;
    color: #ededea;
    font-size: 0.75rem;
    cursor: pointer;
  }
</style>
