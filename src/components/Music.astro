---
import { useTranslations, type Lang } from '../i18n/ui';
import track from '../assets/work/pinbazaar/media/music.m4a?url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<button class="music mono" type="button" aria-pressed="false" title={t('music.label')} data-music={track}>
  <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
  <span class="off">{t('music.off')}</span>
  <span class="on">{t('music.on')}</span>
</button>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-music]');
  if (btn) {
    const KEY = 'music';
    const VOLUME = 0.35;
    let ctx: AudioContext | null = null;
    let gain: GainNode | null = null;
    let source: AudioBufferSourceNode | null = null;
    let buffer: Promise<AudioBuffer> | null = null;
    let on = false;

    const mark = (v: boolean) => {
      on = v;
      btn.setAttribute('aria-pressed', String(v));
    };

    const fade = (to: number, seconds: number) => {
      if (!ctx || !gain) return;
      const now = ctx.currentTime;
      gain.gain.cancelScheduledValues(now);
      gain.gain.setValueAtTime(gain.gain.value, now);
      gain.gain.linearRampToValueAtTime(to, now + seconds);
    };

    const start = async () => {
      ctx ??= new AudioContext();
      if (ctx.state !== 'running') {
        await Promise.race([ctx.resume().catch(() => {}), new Promise((r) => setTimeout(r, 300))]);
      }
      if (ctx.state !== 'running') return;
      mark(true);
      buffer ??= fetch(btn.dataset.music!)
        .then((r) => r.arrayBuffer())
        .then((a) => ctx!.decodeAudioData(a));
      const audio = await buffer.catch(() => null);
      if (!audio) return mark(false);
      if (!on) return;
      if (!gain) {
        gain = ctx.createGain();
        gain.gain.value = 0;
        gain.connect(ctx.destination);
      }
      if (!source) {
        source = ctx.createBufferSource();
        source.buffer = audio;
        source.loop = true;
        source.connect(gain);
        source.start();
      }
      fade(VOLUME, 2.5);
    };

    const stop = () => {
      mark(false);
      if (!ctx || !source) return;
      fade(0, 0.6);
      source.stop(ctx.currentTime + 0.65);
      source = null;
    };

    btn.addEventListener('click', () => {
      try {
        if (on) localStorage.setItem(KEY, 'off');
        else localStorage.removeItem(KEY);
      } catch {}
      if (on) stop();
      else start();
    });

    document.addEventListener('visibilitychange', () => {
      if (!on || !ctx) return;
      if (document.hidden) {
        fade(0, 0.4);
        setTimeout(() => document.hidden && ctx?.suspend(), 450);
      } else {
        ctx.resume().then(() => fade(VOLUME, 1.2));
      }
    });

    addEventListener('pagehide', () => on && fade(0, 0.3));
    addEventListener('pageshow', (e) => {
      if (e.persisted && on && ctx) ctx.resume().then(() => fade(VOLUME, 1.2));
    });

    let muted = false;
    try {
      muted = localStorage.getItem(KEY) === 'off';
    } catch {}
    const nav = (window as { navigation?: { activation?: { from?: { url: string } | null; navigationType?: string } } }).navigation;
    const from = nav?.activation?.from?.url;
    const fromSite = !!from && new URL(from).origin === location.origin;
    const saveData = (navigator as { connection?: { saveData?: boolean } }).connection?.saveData;
    if (!muted && !saveData && fromSite && nav?.activation?.navigationType === 'push') start();
  }
</script>

<style>
  .music {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px 6px 10px;
    border: 1px solid currentColor;
    border-radius: 999px;
    background: none;
    font-size: 0.75rem;
    line-height: 1;
    cursor: pointer;
    opacity: 0.8;
    transition: opacity 0.2s;
  }

  .music:hover,
  .music:focus-visible {
    opacity: 1;
  }

  .eq {
    display: inline-flex;
    align-items: flex-end;
    gap: 2px;
    height: 11px;
  }

  .eq i {
    width: 2px;
    height: 3px;
    border-radius: 1px;
    background: currentColor;
  }

  .music[aria-pressed='true'] .eq i {
    animation: music-eq 0.9s ease-in-out infinite alternate;
  }

  .music[aria-pressed='true'] .eq i:nth-child(2) {
    animation-duration: 0.7s;
    animation-delay: -0.3s;
  }

  .music[aria-pressed='true'] .eq i:nth-child(3) {
    animation-duration: 1.1s;
    animation-delay: -0.6s;
  }

  .music[aria-pressed='true'] .eq i:nth-child(4) {
    animation-duration: 0.8s;
    animation-delay: -0.15s;
  }

  @keyframes music-eq {
    to {
      height: 11px;
    }
  }

  .on,
  .music[aria-pressed='true'] .off {
    display: none;
  }

  .music[aria-pressed='true'] .on {
    display: inline;
  }

  @media (prefers-reduced-motion: reduce) {
    .music[aria-pressed='true'] .eq i {
      animation: none;
      height: 8px;
    }
  }
</style>
