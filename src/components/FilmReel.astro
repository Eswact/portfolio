      56vw 56dvh,
      56vw 56dvh,
      56vw 56dvh,
      auto 3dvh,
      auto 3dvh,
      100% 71dvh;
    background-repeat: no-repeat, no-repeat, no-repeat, no-repeat, repeat-x, repeat-x, no-repeat;
