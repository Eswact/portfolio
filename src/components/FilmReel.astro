<style is:global>
  html.vt-film::view-transition-old(root),
  html.vt-film::view-transition-new(root),
  html.vt-film-back::view-transition-old(root),
  html.vt-film-back::view-transition-new(root) {
    mix-blend-mode: normal;
    transform-origin: 50% 50%;
