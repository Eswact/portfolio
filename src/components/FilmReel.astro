        -38vw 22dvh,
        142vw 22dvh,
        202vw 22dvh,
        0 15.6dvh,
        0 81.4dvh,
        0 14.5dvh;
    }
    64%,
    100% {
      background-position:
        -158vw 22dvh,
        -98vw 22dvh,
        82vw 22dvh,
        142vw 22dvh,
        -60vw 15.6dvh,
        -60vw 81.4dvh,
        0 14.5dvh;
    }
  }

  @keyframes film-bg-back {
    0%,
    30% {
      background-position:
        -158vw 22dvh,
        -98vw 22dvh,
        82vw 22dvh,
        142vw 22dvh,
        0 15.6dvh,
        0 81.4dvh,
