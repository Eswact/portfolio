  html.vt-film::view-transition {
    animation: film-bg 2s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  html.vt-film-back::view-transition {
    animation: film-bg-back 1.7s cubic-bezier(0.65, 0, 0.35, 1) both;
