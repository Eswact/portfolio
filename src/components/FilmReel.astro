    animation: film-back-old 1.7s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

  html.vt-film-back::view-transition-new(root) {
    animation: film-back-new 1.7s cubic-bezier(0.65, 0, 0.35, 1) both;
  }

