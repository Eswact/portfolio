---
import { useTranslations, type Lang } from '../i18n/ui';
import videoTr from '../assets/work/pinbazaar/media/play-tr.mp4?url';
import videoEn from '../assets/work/pinbazaar/media/play-en.mp4?url';
import posterTr from '../assets/work/pinbazaar/media/play-tr-poster.webp?url';
import posterEn from '../assets/work/pinbazaar/media/play-en-poster.webp?url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const video = lang === 'tr' ? videoTr : videoEn;
const poster = lang === 'tr' ? posterTr : posterEn;
---

<div class="panel">
  <div class="phone">
    <div class="screen">
      <div class="status" aria-hidden="true">
        <span class="time">9:41</span>
        <span class="icons">
          <svg viewBox="0 0 18 12"><rect x="0" y="8" width="3" height="4" rx="1"></rect><rect x="5" y="5.5" width="3" height="6.5" rx="1"></rect><rect x="10" y="3" width="3" height="9" rx="1"></rect><rect x="15" y="0" width="3" height="12" rx="1"></rect></svg>
          <svg viewBox="0 0 16 12"><path d="M8 11.5 5.6 9a3.4 3.4 0 0 1 4.8 0zM3.5 6.9a6.4 6.4 0 0 1 9 0l-1.5 1.5a4.3 4.3 0 0 0-6 0zM1.2 4.6a9.6 9.6 0 0 1 13.6 0l-1.5 1.5a7.5 7.5 0 0 0-10.6 0z"></path></svg>
          <svg viewBox="0 0 27 13"><rect x="0.5" y="0.5" width="22" height="12" rx="3.5" fill="none" stroke="currentColor" opacity="0.4"></rect><rect x="2" y="2" width="16" height="9" rx="2"></rect><path d="M24 4.5v4c.9-.3 1.5-1.1 1.5-2s-.6-1.7-1.5-2z" opacity="0.5"></path></svg>
        </span>
      </div>
      <video muted loop playsinline preload="none" width="540" height="1170" aria-label={t('work.run')} data-src={video} data-poster={poster}></video>
    </div>
  </div>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ready = new Promise<void>((r) => (document.readyState === 'complete' ? r() : addEventListener('load', () => r(), { once: true }))).then(() => document.fonts.ready);
  ready.then(() =>
    document.querySelectorAll<HTMLVideoElement>('video[data-src]').forEach((v) => {
      new IntersectionObserver(
        ([e]) => {
          if (e.intersectionRatio >= 0.25) {
            if (!v.poster) {
              v.poster = v.dataset.poster!;
              if (!reduce) v.src = v.dataset.src!;
            }
            if (!reduce) v.play().catch(() => {});
          } else if (!e.isIntersecting) v.pause();
        },
        { threshold: [0, 0.25] },
      ).observe(v);
    }),
  );
</script>

<style>
  .panel {
    --gold: #d9a23a;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    padding: clamp(28px, 5vw, 56px) 16px;
    background-color: var(--surface);
    background-image: radial-gradient(circle, var(--dot, transparent) 1.2px, transparent 1.6px);
    background-size: 22px 22px;
    border: 2px solid var(--gold);
    outline: 1px solid color-mix(in srgb, var(--fg) 35%, transparent);
    outline-offset: 3px;
    transition: background-color 0.6s var(--ease);
  }

  .phone {
    width: 100%;
    max-width: 280px;
    padding: 8px;
    border-radius: 42px;
    background: #0c0c0d;
    box-shadow:
      0 0 0 2px var(--gold),
      0 40px 70px -30px rgb(0 0 0 / 0.6);
  }

  .screen {
    position: relative;
    overflow: hidden;
    border-radius: 34px;
    background: rgb(44 32 64);
    container-type: inline-size;
  }

  .screen::after {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 31.34%;
    aspect-ratio: 126 / 37;
    margin-top: 3.48%;
    border-radius: 999px;
    background: #000;
    transform: translateX(-50%);
  }

  .status {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    aspect-ratio: 402 / 62;
    padding-top: 1.5%;
    color: #fff;
    font-family: -apple-system, system-ui, sans-serif;
  }

  .time {
    width: 75%;
    font-size: 4.2cqw;
    font-weight: 600;
    text-align: center;
  }

  .icons {
    justify-self: end;
    width: 75%;
    display: flex;
    justify-content: center;
    gap: 1.4cqw;
    fill: currentColor;
  }

  .icons svg {
    display: block;
    height: 3cqw;
    width: auto;
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 540 / 1170;
    background: rgb(44 32 64);
  }
</style>
