---
// A catalogue card (Karar 07): model number, status, an object that shows the product's mechanism on hover,
// and spec rows in the same order on every card.
//  phone  (Fibi)            the phone separates into its layers; labels sit level with each plate
//  api    (Barcode API)     eight marketplaces are queried at once and merge into the cheapest price
//  screen (Digital Signage) the panel sends an update and the screens on the wall follow
//  voice  (Warbly)          Karar 14 C: tap the widget, speak, the task lands at the top of the list
//  meeting (Meetnal)        a recording turns into a report with scores
import type { FeaturedProject } from '../data/projects';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  project: FeaturedProject;
  lang: Lang;
}

const { project: p, lang } = Astro.props;
const t = useTranslations(lang);
const tr = lang === 'tr';
const { card } = p;
const n = card.layers.length;

// Barcode diagram: real result of the first query in the case study (8690504085720).
const markets = [
  { name: 'Trendyol', found: true },
  { name: 'Hepsiburada', found: false },
  { name: 'Pazarama', found: false },
  { name: 'CarrefourSA', found: true },
  { name: 'Mopaş', found: true },
  { name: 'Afta Market', found: false },
  { name: 'Şok Market', found: true },
  { name: 'Market Karşılaştır', found: true, best: true },
];
const rowY = (i: number) => 22 + i * 25;

// Warbly diagram (Karar 14 C): the example sentence from its store page, in three short lines so it stays inside the phone.
const voice = tr
  ? {
      said: [['“Bu', 'akşam', '9’da'], ['anneanneme', 'gideceğim,'], ['önce', 'çiçek', 'alacağım”']],
      state: 'dinliyor',
      title: 'Görevler',
      today: 'BUGÜN',
      task: 'Anneanneme ziyaret et',
      when: 'Bugün · 21:00',
      sub: 'Çiçek al',
      others: [['Faturayı öde', 'Bugün · 18:00'], ['Spora git', 'Bugün · 19:30']],
      toast: 'Görev eklendi',
      undo: 'Geri al',
      steps: [
        ['Widget’a dokun', ['Ana ekrandan tek dokunuş']],
        ['Konuş', ['“Bu akşam 9’da anneanneme', 'gideceğim, önce çiçek alacağım”']],
        ['Listede', ['Bugün 21:00 · alt görev:', 'Çiçek al']],
      ],
    }
  : {
      said: [['“Tonight', 'at', '9', 'I’m'], ['visiting', 'grandma,'], ['buying', 'flowers', 'first”']],
      state: 'listening',
      title: 'Tasks',
      today: 'TODAY',
      task: 'Visit grandma',
      when: 'Today · 21:00',
      sub: 'Buy flowers',
      others: [['Pay the bill', 'Today · 18:00'], ['Go to the gym', 'Today · 19:30']],
      toast: 'Task added',
      undo: 'Undo',
      steps: [
        ['Tap the widget', ['One tap from the home screen']],
        ['Speak', ['“Tonight at 9 I’m visiting', 'grandma, buying flowers first”']],
        ['On the list', ['Today 21:00 · subtask:', 'Buy flowers']],
      ],
    };
const appGrid = [38, 68, 98].flatMap((y) => [52, 75, 98, 121].map((x) => ({ x, y })));

// Meetnal diagram: a recording, then the report's scores.
const meeting = tr
  ? { title: 'Haftalık toplantı', overall: 'Genel', upload: 'analize gönder', kinds: ['Netlik', 'Verimlilik', 'İletişim', 'Sonuç'] }
  : { title: 'Weekly meeting', overall: 'Overall', upload: 'send for analysis', kinds: ['Clarity', 'Efficiency', 'Communication', 'Outcome'] };
const bars = [6, 12, 20, 9, 26, 15, 30, 18, 11, 24, 16, 8];
---

<article class="card" data-object={card.object}>
  <div class="top mono">
    <span>{card.code}</span>
    <span class:list={['status', card.status]}>{t(`status.${card.status}`)}</span>
  </div>

  <div class="obj" aria-hidden="true">
    {
      card.object === 'phone' && (
        <>
          <div class="stack" style={`--n:${n}`}>
            {card.layers.map((_, i) => (
              <b style={`--i:${n - 1 - i}`} />
            ))}
          </div>
          <ul class="layers" role="list">
            {card.layers.map((l, i) => (
              <li style={`--i:${n - 1 - i}`}>{l[lang]}</li>
            ))}
          </ul>
        </>
      )
    }

    {
      card.object === 'api' && (
        <svg class="diagram api" viewBox="0 0 360 224">
          {markets.map((m, i) => (
            <g class:list={['src', { miss: !m.found }]} style={`--d:${(i % 4) * 90 + Math.floor(i / 4) * 45}ms`}>
              <rect x="12" y={rowY(i) - 9} width="108" height="18" rx="3" />
              <text x="19" y={rowY(i) + 3.5}>
                {m.name}
              </text>
              <path class="wire" d={`M120 ${rowY(i)} C 166 ${rowY(i)}, 174 112, 214 112`} pathLength="100" />
              {m.found && <path class="pk" d={`M120 ${rowY(i)} C 166 ${rowY(i)}, 174 112, 214 112`} pathLength="100" />}
            </g>
          ))}
          <circle class="node" cx="214" cy="112" r="3.5" />
          <g class="result">
            <rect x="226" y="80" width="122" height="64" rx="5" />
            <text class="r-k" x="238" y="99">
              {tr ? 'En ucuz · 5/8 market' : 'Cheapest · 5/8 markets'}
            </text>
            <text class="r-v" x="238" y="122">
              ₺16,00
            </text>
            <text class="r-k" x="238" y="136">
              Market Karşılaştır
            </text>
          </g>
        </svg>
      )
    }

    {
      card.object === 'screen' && (
        <svg class="diagram signage" viewBox="0 0 360 224">
          <g class="panel">
            <rect class="win" x="14" y="62" width="124" height="96" rx="4" />
            <line class="sep" x1="14" y1="74" x2="138" y2="74" />
            <circle class="dot" cx="21" cy="68" r="1.6" />
            <circle class="dot" cx="27" cy="68" r="1.6" />
            <circle class="dot" cx="33" cy="68" r="1.6" />
            <rect class="side" x="14" y="74" width="26" height="84" />
            <rect class="ln" x="48" y="84" width="60" height="5" rx="1" />
            <rect class="ln" x="48" y="96" width="80" height="12" rx="2" />
            <rect class="ln" x="48" y="112" width="80" height="12" rx="2" />
            <rect class="ln new" x="48" y="128" width="80" height="12" rx="2" />
            <text class="tag" x="54" y="137">
              49 · Latte
            </text>
          </g>
          {[
            'M138 110 C 168 110, 170 62, 196 62',
            'M138 110 C 168 110, 176 150, 196 152',
            'M138 110 C 200 110, 250 150, 276 152',
          ].map((d, i) => (
            <>
              <path class="wire" d={d} pathLength="100" />
              <path class="pk" d={d} pathLength="100" style={`--d:${i * 70}ms`} />
            </>
          ))}
          <g class="tv big">
            <rect class="case" x="196" y="22" width="150" height="86" rx="4" />
            <rect class="glass" x="200" y="26" width="142" height="78" rx="1.5" />
            <text class="h" x="206" y="38">
              {tr ? 'Siparişler' : 'Orders'}
            </text>
            <rect class="colA" x="206" y="43" width="62" height="56" rx="1.5" />
            <rect class="colB" x="273" y="43" width="62" height="56" rx="1.5" />
            <text class="num" x="211" y="58">
              41
            </text>
            <text class="num" x="211" y="74">
              42
            </text>
            <text class="num fresh" x="211" y="90">
              49
            </text>
            <text class="num" x="278" y="58">
              46
            </text>
            <text class="num" x="278" y="74">
              47
            </text>
          </g>
          <g class="tv">
            <rect class="case" x="196" y="128" width="70" height="46" rx="3" />
            <rect class="glass dark" x="199" y="131" width="64" height="40" rx="1" />
            <text class="q old" x="231" y="157" text-anchor="middle">
              A042
            </text>
            <text class="q fresh" x="231" y="157" text-anchor="middle">
              A043
            </text>
          </g>
          <g class="tv">
            <rect class="case" x="276" y="128" width="70" height="46" rx="3" />
            <rect class="glass dark" x="279" y="131" width="64" height="40" rx="1" />
            <rect class="ln-tv" x="285" y="138" width="34" height="4" rx="1" />
            <rect class="ln-tv soft" x="285" y="147" width="46" height="3" rx="1" />
            <rect class="ln-tv soft" x="285" y="154" width="40" height="3" rx="1" />
            <rect class="band" x="279" y="163" width="64" height="8" />
          </g>
        </svg>
      )
    }

    {
      card.object === 'voice' && (
        <svg class="diagram voice" viewBox="0 0 360 224">
          <rect class="body-p" x="40" y="12" width="112" height="200" rx="16" />
          <line class="ear" x1="86" y1="21" x2="106" y2="21" />

          <g class="wb-s1">
            {appGrid.map(({ x, y }) =>
              x === 75 && y === 98 ? (
                <>
                  <rect class="mic" x={x} y={y} width="16" height="16" rx="4" />
                  <rect class="mic-g" x="81.4" y="101.5" width="3.2" height="6" rx="1.6" />
                  <path class="mic-s thin" d="M79.6 106a3.4 3.4 0 0 0 6.8 0M83 109.6v1.6" />
                </>
              ) : (
                <rect class="app-i" x={x} y={y} width="16" height="16" rx="4" />
              ),
            )}
            <text class="r-k tiny" x="83" y="122" text-anchor="middle">
              Warbly
            </text>
            <circle class="wb-ripple" cx="83" cy="106" r="14" />
            {[52, 75, 98, 121].map((x) => (
              <rect class="app-i" x={x} y="180" width="16" height="16" rx="4" />
            ))}
          </g>

          <g class="wb-s2">
            <circle class="ring" cx="96" cy="80" r="17" />
            <circle class="ring r2" cx="96" cy="80" r="17" />
            <circle class="mic" cx="96" cy="80" r="17" />
            <rect class="mic-g" x="92.2" y="70.5" width="7.6" height="12.5" rx="3.8" />
            <path class="mic-s" d="M87.8 79.5a8.2 8.2 0 0 0 16.4 0M96 87.7v3.8" />
            <text class="r-k small" x="96" y="116" text-anchor="middle">
              {voice.state}
            </text>
            {voice.said.map((line, li) => (
              <text class="sans said" x="96" y={138 + li * 11} text-anchor="middle">
                {line.map((w, wi) => (
                  <tspan class="wb-w" style={`--d:${(voice.said.slice(0, li).flat().length + wi) * 110}ms`}>
                    {w}{' '}
                  </tspan>
                ))}
              </text>
            ))}
          </g>

          <g class="wb-s3">
            <text class="sans list-h" x="52" y="44">
              {voice.title}
            </text>
            <text class="r-k tiny" x="52" y="58">
              {voice.today}
            </text>
            <g class="wb-new">
              <rect class="row hot" x="50" y="64" width="92" height="40" rx="5" />
              <rect class="box" x="55" y="70" width="6" height="6" rx="1.5" />
              <text class="sans row-t" x="65" y="75.5">
                {voice.task}
              </text>
              <text class="tiny when" x="65" y="84">
                {voice.when}
              </text>
              <line class="div" x1="65" y1="89" x2="137" y2="89" />
              <rect class="box" x="65" y="93" width="5" height="5" rx="1.2" />
              <text class="r-k tiny" x="74" y="97.6">
                {voice.sub}
              </text>
            </g>
            <g class="wb-others">
              {voice.others.map(([title, when], i) => (
                <>
                  <rect class="row" x="50" y={64 + i * 30} width="92" height="26" rx="5" />
                  <rect class="box" x="55" y={70 + i * 30} width="6" height="6" rx="1.5" />
                  <text class="sans row-t" x="65" y={75.5 + i * 30}>
                    {title}
                  </text>
                  <text class="r-k tiny" x="65" y={84 + i * 30}>
                    {when}
                  </text>
                </>
              ))}
            </g>
            <g class="wb-toast">
              <rect x="50" y="184" width="92" height="17" rx="5" />
              <text x="56" y="194.6">
                {voice.toast}
              </text>
              <text class="undo" x="136" y="194.6" text-anchor="end">
                {voice.undo}
              </text>
            </g>
          </g>

          {voice.steps.map(([title, lines], i) => (
            <g class:list={['wb-step', `wb-step${i + 1}`]}>
              <text x="176" y={56 + i * 50}>
                {String(i + 1).padStart(2, '0')}
              </text>
              <text class="sans step-t" x="196" y={56 + i * 50}>
                {title}
              </text>
              {(lines as string[]).map((line, li) => (
                <text class="r-k" x="196" y={69 + i * 50 + li * 11}>
                  {line}
                </text>
              ))}
            </g>
          ))}
        </svg>
      )
    }

    {
      card.object === 'meeting' && (
        <svg class="diagram meeting" viewBox="14 0 360 224">
          <g class="handset">
            <rect class="body-p" x="40" y="30" width="84" height="164" rx="14" />
            <line class="ear" x1="72" y1="39" x2="92" y2="39" />
            <circle class="dot-rec" cx="56" cy="58" r="3" />
            <text class="r-k" x="63" y="61">
              REC
            </text>
            <text class="clock" x="82" y="90" text-anchor="middle">
              47:12
            </text>
            {bars.map((h, i) => (
              <rect class="lvl" x={52 + i * 5} y={118 - h / 2} width="2.5" height={h} rx="1.25" style={`--d:${(i % 5) * 90}ms`} />
            ))}
            <circle class="rec-btn" cx="82" cy="160" r="13" />
            <rect class="rec-stop" x="78" y="156" width="8" height="8" rx="2" />
          </g>
          <path class="wire" d="M124 112 L 206 112" pathLength="100" />
          <path class="pk" d="M124 112 L 206 112" pathLength="100" />
          <text class="r-k up" x="165" y="104" text-anchor="middle">
            {meeting.upload}
          </text>
          <g class="report">
            <rect class="sheet" x="206" y="38" width="142" height="148" rx="8" />
            <text x="216" y="56">
              {meeting.title}
            </text>
            <line class="div" x1="216" y1="64" x2="338" y2="64" />
            <g class="fresh">
              <text class="big-n" x="216" y="92">
                8
              </text>
              <text class="r-k" x="234" y="91">
                {meeting.overall}
              </text>
            </g>
            {meeting.kinds.map((k, i) => (
              <>
                <text class="r-k" x="216" y={114 + i * 18}>
                  {k}
                </text>
                <rect class="track" x="290" y={109 + i * 18} width="48" height="4" rx="2" />
                <rect class="fill" x="290" y={109 + i * 18} width={i < 2 ? 38 : 34} height="4" rx="2" style={`--d:${700 + i * 120}ms`} />
              </>
            ))}
          </g>
        </svg>
      )
    }
  </div>

  <div class="body">
    <h3>
      <a class="go" href={localePath(lang, `/work/${p.slug}`)}>
        <span class="name" data-vt={localePath(lang, `/work/${p.slug}`)}>{p.title}</span>
      </a>
      <span class="type">{p.type[lang]}</span>
    </h3>
    <dl class="mono">
      <dt>{t('spec.platform')}</dt>
      <dd>{card.platform[lang]}</dd>
      <dt>{t('spec.stack')}</dt>
      <dd>{p.stack.slice(0, 4).join(' · ')}</dd>
      <dt>{t('spec.year')}</dt>
      <dd class="num">{card.year}</dd>
    </dl>
  </div>
</article>

<style>
  /* Only the name is the link (a short accessible name); its ::after stretches over the whole card. */
  .card {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr;
    background: var(--card);
    border: 1px solid var(--line);
    text-decoration: none;
    transition:
      opacity 0.45s var(--ease),
      border-color 0.3s,
      background-color 0.6s var(--ease);
  }

  .card:hover,
  .card:has(:focus-visible) {
    border-color: var(--fg);
  }

  .top {
    display: flex;
    justify-content: space-between;
    padding: 12px 14px;
    font-size: 0.8125rem;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 7px;
    color: var(--muted);
  }

  .status::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    border: 1px solid var(--fg);
  }

  .status.live::before {
    background: var(--fg);
  }

  .obj {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
    transition: background-color 0.6s var(--ease);
  }

  .obj::after {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    background: radial-gradient(ellipse 60% 70% at 50% 12%, rgb(255 250 235 / 0.16), transparent 72%);
    transition: opacity 0.45s var(--ease);
  }

  .card:hover .obj::after,
  .card:has(:focus-visible) .obj::after {
    opacity: var(--spot);
  }

  /* ---------- phone: plates in isometric view; --g is the gap between them ---------- */
  /* A plate lifted by translateZ(d) rises 0.829·d on screen (rotateX 56°): labels follow that rise. */
  .stack {
    --g: 4px;
    position: absolute;
    left: 32%;
    top: 54%;
    width: 84px;
    height: 148px;
    margin: -74px 0 0 -42px;
    transform-style: preserve-3d;
    transform: rotateX(56deg) rotateZ(-36deg);
  }

  .stack b {
    position: absolute;
    inset: 0;
    border: 1.5px solid var(--fg);
    border-radius: 15px;
    background: var(--card);
    transform: translateZ(calc(var(--i) * var(--g)));
    transition:
      transform 0.65s var(--spring),
      background-color 0.6s var(--ease),
      border-color 0.6s var(--ease);
  }

  .stack b:last-child {
    background: var(--fg);
  }

  .stack b:first-child::after {
    content: '';
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 12px;
    height: 14px;
    border-radius: 7px;
    background: var(--product-fibi);
  }

  .layers {
    --g: 4px;
    position: absolute;
    left: 56%;
    right: 10px;
    top: 54%;
    height: 0;
    font-size: 0.6875rem;
  }

  .layers li {
    position: absolute;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    gap: 8px;
    white-space: nowrap;
    transform: translateY(calc(-50% - var(--i) * var(--g) * 0.829));
    opacity: 0;
    transition:
      transform 0.65s var(--spring),
      opacity 0.3s;
  }

  .layers li::before {
    content: '';
    flex: none;
    width: 22px;
    height: 1px;
    background: var(--muted);
  }

  .card:hover .stack,
  .card:hover .layers,
  .card:has(:focus-visible) .stack,
  .card:has(:focus-visible) .layers {
    --g: 30px;
  }

  .card:hover .layers li,
  .card:has(:focus-visible) .layers li {
    opacity: 1;
    transition-delay: 0.12s, 0.18s;
  }

  /* ---------- diagrams (api, screen): drawn in the page's ink ---------- */
  .diagram {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
  }

  .diagram text {
    fill: var(--fg);
    font-size: 8.5px;
  }

  .wire {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  /* A packet: a short dash that travels the wire on hover. */
  .pk {
    fill: none;
    stroke: var(--fg);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 4 120;
    stroke-dashoffset: 4;
    opacity: 0;
  }

  .card:hover .pk,
  .card:has(:focus-visible) .pk {
    animation: travel 1.15s var(--ease) var(--d, 0ms) 2 both;
  }

  @keyframes travel {
    0% {
      stroke-dashoffset: 4;
      opacity: 1;
    }
    90% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }

  .src rect {
    fill: var(--card);
    stroke: var(--fg);
    stroke-width: 1;
    transition:
      fill 0.3s,
      stroke 0.3s;
  }

  .src.miss {
    opacity: 0.42;
  }

  .src.miss rect {
    stroke: var(--muted);
    stroke-dasharray: 2 2;
  }

  .node {
    fill: var(--fg);
  }

  .result rect {
    fill: var(--fg);
  }

  .result text {
    fill: var(--card);
  }

  .diagram .r-k {
    font-size: 7.5px;
    opacity: 0.7;
  }

  .diagram .r-v {
    font-family: var(--font-sans);
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .result {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.5s var(--spring);
  }

  .card:hover .result,
  .card:has(:focus-visible) .result {
    animation: land 2.4s var(--ease) both;
  }

  @keyframes land {
    0%,
    45% {
      transform: scale(0.94);
      opacity: 0.35;
    }
    60%,
    100% {
      transform: none;
      opacity: 1;
    }
  }

  /* signage */
  .win {
    fill: var(--card);
    stroke: var(--fg);
    stroke-width: 1;
  }

  .sep,
  .side {
    stroke: var(--line);
    fill: var(--surface);
  }

  .dot {
    fill: var(--line);
  }

  .ln {
    fill: var(--surface);
  }

  .ln.new {
    fill: color-mix(in srgb, var(--fg) 12%, transparent);
  }

  .diagram .tag {
    font-size: 6.5px;
  }

  .case {
    fill: #0c0c0d;
  }

  .glass {
    fill: #f5f5f3;
  }

  .glass.dark {
