---
import Architecture from './Architecture.astro';
import CaseDemo from './CaseDemo.astro';
import Gallery from './Gallery.astro';
import Music from './Music.astro';
import PlayVideo from './PlayVideo.astro';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { cases } from '../data/cases';
import { featured, type FeaturedProject } from '../data/projects';
import { localePath, useTranslations, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  project: FeaturedProject;
}

const { lang, project: p } = Astro.props;
const t = useTranslations(lang);
const c = cases[p.slug];
const index = featured.findIndex((f) => f.slug === p.slug);
const next = featured[(index + 1) % featured.length];
const boards = import.meta.glob<ImageMetadata>('../assets/work/*/tables/*.png', { eager: true, import: 'default' });
const board = (id: string) => boards[`../assets/work/${p.slug}/tables/${id}.png`];
const roads = c.tables
  ? [
      { id: 'free', shield: lang === 'tr' ? 'D-10' : 'R-10', label: t('work.roadFree'), rows: c.tables.filter((x) => !x.paid) },
      { id: 'paid', shield: lang === 'tr' ? 'O-8' : 'M-8', label: t('work.roadPaid'), rows: c.tables.filter((x) => x.paid) },
    ]
  : [];
---

<article class="case">
  <nav class="container crumbs mono" aria-label={t('work.caseStudy')}>
    <a class="link" href={`${localePath(lang, '/')}#work`}>← {t('work.back')}</a>
    <span class="crumbs-end">
      {c.music && <Music lang={lang} />}
      <span class="muted num">{p.card.code} · {index + 1} / {featured.length}</span>
    </span>
  </nav>

  <header class="container head">
    <h1><span class="name" data-vt={localePath(lang, `/work/${p.slug}`)}>{p.title}</span></h1>
    <div class="promise">
      <p class="claim">{c.claim[lang]}</p>
      <p class="muted">{p.summary[lang]}</p>
    </div>
  </header>

  <dl class="container facts">
    <div>
      <dt class="mono muted">{t('work.role')}</dt>
      <dd>{c.role[lang]}</dd>
    </div>
    <div>
      <dt class="mono muted">{t('spec.year')}</dt>
      <dd class="num">{p.card.year}</dd>
    </div>
    <div>
      <dt class="mono muted">{t('index.status')}</dt>
      <dd><span class:list={['status', p.card.status]}>{t(`status.${p.card.status}`)}</span></dd>
    </div>
    <div>
      <dt class="mono muted">{t('spec.stack')}</dt>
      <dd>{p.stack.join('\u00a0· ')}</dd>
    </div>
    <div>
      <dt class="mono muted">{t('work.links')}</dt>
      <dd class="links">
        {p.stores?.map((s) =>
          s.href && (
            <a class="link arrow" href={s.href}>
              {s.name}
            </a>
          ),
        )}
        {p.live && <a class="link arrow" href={p.live}>{t(p.demo ? 'work.demoLink' : 'work.live')}</a>}
        {p.release && <a class="link arrow" href={p.release}>{t('work.app')}</a>}
        {p.source?.map((href) => <a class="link arrow" href={href}>{t('work.source')}</a>)}
        {p.stores?.map(
          (s) =>
            !s.href && (
              <span class="soon">
                {s.name} <span class="mono">{t('work.soon')}</span>
              </span>
            ),
        )}
      </dd>
    </div>
  </dl>

  <section class="container stage" aria-labelledby="architecture">
    <div class="rule">
      <h2 id="architecture">{t('work.architecture')}</h2>
    </div>
    <Architecture layers={c.layers} lang={lang}>
      {c.demo === 'pinbazaar' ? <PlayVideo lang={lang} /> : <CaseDemo kind={c.demo} lang={lang} />}
    </Architecture>
  </section>

  {
    c.gallery.length > 0 && (
      <section class="container block" aria-labelledby="screens">
        <div class="rule">
          <h2 id="screens">{t('work.screens')}</h2>
        </div>
        <Gallery surfaces={c.gallery} lang={lang} note={c.galleryNote?.[lang]} />
      </section>
    )
  }

  {
    c.tables && (
      <section class="container block" aria-labelledby="tables">
        <div class="rule">
          <h2 id="tables">{t('work.tables')}</h2>
        </div>
        {roads.map((road) => (
          <div class:list={['road', road.id]}>
            <p class="sign">
              <span class="shield">{road.shield}</span>
              {road.label}
            </p>
            <ul class="boards" role="list" data-boards>
              {road.rows.map((b) => (
                <li>
                  <Picture
                    src={board(b.id)}
                    alt=""
                    widths={[270, 540]}
                    sizes="(min-width: 1100px) 230px, (min-width: 900px) 18vw, (min-width: 700px) 40vw, 66vw"
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    loading="lazy"
                    decoding="async"
                  />
                  <h3>{b.name[lang]}</h3>
                  <p class="muted">{b.trick[lang]}</p>
                </li>
              ))}
            </ul>
            <div class="pager" data-pager>
              <span class="dots" aria-hidden="true">
                {road.rows.map((_, i) => (
                  <i class:list={{ on: i === 0 }} />
                ))}
              </span>
              <button type="button" class="step" data-step="-1" aria-label={t('work.prevTable')} disabled>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M12.5 4.5L7 10l5.5 5.5" /></svg>
              </button>
              <button type="button" class="step" data-step="1" aria-label={t('work.nextTable')}>
                <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M7.5 4.5L13 10l-5.5 5.5" /></svg>
              </button>
            </div>
          </div>
        ))}
      </section>
    )
  }

  <section class="container block" aria-labelledby="how">
    <div class="rule">
      <h2 id="how">{t('work.how')}</h2>
    </div>
    <div class="sections">
      {
        c.sections.map((s) => (
          <section class="row">
            <h3>{s.title[lang]}</h3>
            <p>{s.body[lang]}</p>
          </section>
        ))
      }
    </div>
  </section>

  <div class="container">
    <a class="next" href={localePath(lang, `/work/${next.slug}`)}>
      <span class="label mono muted">{t('work.next')} · {next.card.code}</span>
      <span class="next-title"><span class="name" data-vt={localePath(lang, `/work/${next.slug}`)}>{next.title}</span></span>
      <span class="muted next-type">{next.type[lang]}</span>
    </a>
  </div>
</article>

<script>
  document.querySelectorAll<HTMLElement>('[data-boards]').forEach((list) => {
    const pager = list.nextElementSibling as HTMLElement;
    const dots = [...pager.querySelectorAll('i')];
    const [prev, next] = pager.querySelectorAll<HTMLButtonElement>('[data-step]');
    const items = [...list.children] as HTMLElement[];
    let current = 0;
    let frame = 0;

    const update = () => {
      frame = 0;
      const max = list.scrollWidth - list.clientWidth;
      const step = items[1] ? items[1].offsetLeft - items[0].offsetLeft : 1;
      const i = list.scrollLeft >= max - 2 ? items.length - 1 : Math.round(list.scrollLeft / step);
      prev.disabled = list.scrollLeft <= 2;
      next.disabled = list.scrollLeft >= max - 2;
      if (i === current) return;
      dots[current]?.classList.remove('on');
      dots[i]?.classList.add('on');
      current = i;
    };

    list.addEventListener('scroll', () => (frame ||= requestAnimationFrame(update)), { passive: true });
    pager.addEventListener('click', (e) => {
      const button = (e.target as Element).closest<HTMLButtonElement>('[data-step]');
      if (!button) return;
      const i = Math.max(0, Math.min(items.length - 1, current + Number(button.dataset.step)));
      list.scrollTo({ left: items[i].offsetLeft - items[0].offsetLeft, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  });
</script>

<style>
  .case {
    padding-bottom: clamp(64px, 8vw, 112px);
  }

  .crumbs {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 8px 0;
    font-size: 0.75rem;
  }

  .crumbs a {
    text-decoration: none;
  }

  .head {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 20px 16px;
    align-items: end;
    padding-block: clamp(40px, 7vw, 96px) clamp(32px, 4vw, 48px);
  }

  h1 {
    grid-column: 1 / span 6;
    font-size: clamp(3.25rem, 1.6rem + 6vw, 6rem);
    font-weight: 600;
    line-height: 0.9;
    letter-spacing: -0.04em;
    overflow-wrap: anywhere;
  }

  .promise {
    grid-column: 7 / -1;
    display: grid;
    gap: 14px;
    padding-bottom: 6px;
  }

  .claim {
    font-size: var(--step-2);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .promise .muted {
    max-width: 52ch;
  }

  .facts {
    display: grid;
    grid-template-columns: 2fr 1fr 1.3fr 4fr 2.4fr;
    gap: 16px;
  }

  .facts > div {
    display: grid;
    gap: 6px;
    align-content: start;
    padding-top: 12px;
    border-top: 1px solid var(--fg);
    min-width: 0;
  }

  .facts dt {
    font-size: 0.75rem;
  }

  .facts dd {
    margin: 0;
    font-size: 0.9375rem;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
  }

  .status {
    color: var(--muted);
  }

  .status::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 6px;
    border-radius: 50%;
    border: 1px solid var(--fg);
    vertical-align: 1px;
  }

  .status.soon::before {
    background: linear-gradient(90deg, var(--fg) 50%, transparent 50%);
  }

  .status.live::before {
    background: var(--fg);
  }

  .stage {
    padding-block: clamp(32px, 5vw, 56px) 0;
  }

  .block {
    padding-top: clamp(72px, 9vw, 128px);
  }

  .rule {
    padding-top: 12px;
    border-top: 1px solid var(--fg);
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  h2 {
    font-size: var(--step-0);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .row {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 8px 16px;
    padding-block: 20px 28px;
    border-bottom: 1px solid var(--line);
  }

  .row:first-child {
    padding-top: 0;
  }

  .row h3 {
    grid-column: 1 / span 4;
    font-size: var(--step-1);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .row p {
    grid-column: 6 / -1;
    max-width: 64ch;
  }

  .next {
    display: grid;
    gap: 8px;
    margin-top: clamp(72px, 9vw, 128px);
    padding-top: 12px;
    border-top: 1px solid var(--fg);
    text-decoration: none;
  }

  .next .label {
    font-size: 0.75rem;
  }

  .name {
    display: inline-block;
  }

  .next-title {
    font-size: var(--step-3);
    font-weight: 500;
    line-height: 1.04;
    letter-spacing: -0.035em;
    transition: transform 0.5s var(--ease);
  }

  .next:hover .next-title,
  .next:focus-visible .next-title {
    transform: translateX(12px);
  }


  .crumbs-end {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .soon {
    white-space: nowrap;
  }

  .soon .mono {
    margin-left: 4px;
    padding: 2px 6px;
    border: 1px dashed var(--line);
    font-size: 0.6875rem;
    color: var(--muted);
  }

  .road {
    content-visibility: auto;
    contain-intrinsic-block-size: auto 560px;
  }

  .road + .road {
    margin-top: clamp(40px, 5vw, 64px);
  }

  .sign {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    padding: 6px 12px 6px 8px;
    border: 2px solid #fff;
    outline: 2px solid #1c4fa0;
    border-radius: 6px;
    background: #1c4fa0;
    color: #fff;
    font-size: 0.9375rem;
    font-weight: 600;
  }

  .paid .sign {
    outline-color: #1f7a3c;
    background: #1f7a3c;
  }

  .shield {
    padding: 3px 6px;
    border: 1.5px solid #fff;
    border-radius: 4px 4px 9px 9px;
    font-size: 0.75rem;
    line-height: 1;
  }

  .boards {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 24px 16px;
  }

  .boards li {
    display: grid;
    gap: 6px;
    align-content: start;
    min-width: 0;
  }

  .boards :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 270 / 450;
    margin-bottom: 8px;
    background: var(--surface);
  }

  .boards h3 {
    font-size: var(--step-0);
    font-weight: 600;
  }

  .boards p {
    font-size: 0.875rem;
  }

  :global(html[data-skin='pinbazaar']) .rule {
    border-top: 0;
    padding-top: 18px;
    background: repeating-linear-gradient(90deg, #2346a0 0 8px, #2fb5b0 8px 16px, transparent 16px 24px, #d8432f 24px 32px, transparent 32px 40px) top / 100% 6px no-repeat;
  }

  .pager {
    display: none;
  }

  @media (max-width: 899px) {
    .road {
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
    }

    .boards {
      grid-auto-flow: column;
      grid-template-columns: none;
      grid-auto-columns: min(66%, 300px);
      gap: 16px;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scroll-padding-inline: var(--gutter);
      overflow-x: auto;
      overscroll-behavior-x: contain;
      contain: inline-size;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .boards::-webkit-scrollbar {
      display: none;
    }

    .boards li {
      scroll-snap-align: start;
    }

    .pager {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-top: 16px;
    }

    .dots {
      display: flex;
      gap: 6px;
      margin-right: auto;
    }

    .dots i {
      width: 6px;
      height: 6px;
      border-radius: 3px;
      background: var(--line);
      transition: width 0.3s cubic-bezier(0.2, 0.8, 0.2, 1), background-color 0.3s;
    }

    .dots i.on {
      width: 20px;
      background: var(--fg);
    }

    .step {
      display: grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border: 0;
      background: none;
      color: var(--fg);
      cursor: pointer;
    }

    .step svg {
      width: 32px;
      height: 32px;
      padding: 7px;
      border: 1px solid var(--line);
      border-radius: 50%;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
      transition: border-color 0.2s, opacity 0.2s;
    }

    .step:disabled {
      cursor: default;
      opacity: 0.35;
    }

    .step:not(:disabled):active svg {
      border-color: var(--fg);
    }

    h1,
    .promise {
      grid-column: 1 / -1;
    }

    .facts {
      grid-template-columns: 1fr 1fr;
    }

    .row h3,
    .row p {
      grid-column: 1 / -1;
    }
  }
</style>
