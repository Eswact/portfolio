  .phone {
    --a-bg: #e7e7e5;
    --a-card: #fafaf9;
    --a-fg: #18181b;
    --a-muted: #71717a;
    --a-line: #dcdcd8;
    --a-chip: #ededeb;
    position: relative;
    width: 272px;
    height: 556px;
    padding: 9px;
    border-radius: 44px;
    background: #0c0c0d;
    box-shadow:
      0 50px 80px -44px rgb(0 0 0 / 0.55),
      inset 0 0 0 1px rgb(255 255 255 / 0.05);
  }

  :global(:root[data-theme='dark']) .phone {
    --a-bg: #0d0d0e;
    --a-card: #1c1c1e;
    --a-fg: #f2f2f0;
    --a-muted: #8b8b90;
    --a-line: #2a2a2d;
    --a-chip: #232326;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .phone {
      --a-bg: #0d0d0e;
      --a-card: #1c1c1e;
      --a-fg: #f2f2f0;
      --a-muted: #8b8b90;
      --a-line: #2a2a2d;
      --a-chip: #232326;
    }
  }

  .app {
    position: relative;
    height: 100%;
    border-radius: 36px;
    overflow: hidden;
    background: var(--a-bg);
    color: var(--a-fg);
    font-size: 12px;
    line-height: 1.3;
    transition: background-color 0.6s var(--ease);
  }

  .scr {
    position: absolute;
    inset: 0;
    padding: 44px 16px 16px;
    display: flex;
    flex-direction: column;
    opacity: 0;
    transform: translateX(14px);
    transition:
      opacity 0.22s var(--ease),
      transform 0.6s var(--ease);
  }

  .scr.on {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.4s var(--ease),
      transform 0.6s var(--ease);
  }

  .top {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 18px;
    font-size: 13px;
  }

  .back {
    width: 9px;
    height: 9px;
    border-left: 1.6px solid currentColor;
    border-bottom: 1.6px solid currentColor;
    transform: rotate(45deg);
  }

  .h {
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .sub {
    margin-top: 3px;
    color: var(--a-muted);
    font-size: 11.5px;
  }

  .lbl {
    display: block;
    color: var(--a-muted);
    font-size: 10px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .mic {
    position: relative;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    margin: 54px auto 30px;
  }

  .mic .dot {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 78px;
    height: 78px;
    border-radius: 50%;
    background: var(--product-fibi);
  }

  .mic svg,
  .cat svg,
  .ico svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #0c0c0d;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .mic rect {
    fill: #0c0c0d;
    stroke: none;
  }

  .ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--product-fibi);
    opacity: 0;
  }

  .s-add.on .ring {
    animation: listen 1.6s var(--ease) infinite;
  }

  .s-add.on .r2 {
    animation-delay: 0.8s;
  }

  @keyframes listen {
    0% {
      transform: scale(0.7);
      opacity: 0.9;
    }
    100% {
      transform: scale(1.35);
      opacity: 0;
    }
  }

  .said {
    min-height: 3em;
    text-align: center;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .w {
    opacity: 0.12;
    transition: opacity 0.3s;
  }

  .w.on {
    opacity: 1;
  }

  .sheet {
    display: grid;
    gap: 5px;
    margin-top: 12px;
    padding: 12px;
    border-radius: 18px;
    background: var(--a-card);
  }

  .field {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    margin-bottom: 6px;
    padding-inline: 11px;
    border: 1px solid var(--a-line);
    border-radius: 11px;
    font-size: 12.5px;
  }

  .field.big {
    height: 38px;
    font-size: 17px;
    font-weight: 600;
  }

  .field em {
    font-style: normal;
    color: var(--a-muted);
    font-weight: 500;
  }

  .cat svg {
    width: 16px;
    height: 16px;
    stroke: var(--a-fg);
  }

  .chips {
    display: flex;
    gap: 5px;
    margin: -1px 0 7px;
  }

  .chips i {
    padding: 4px 9px;
    border-radius: 99px;
    background: var(--a-chip);
    font-style: normal;
    font-size: 10px;
  }

  .chips .sel {
    background: var(--product-fibi);
    color: #0c0c0d;
    font-weight: 600;
  }

  .inv {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 10px;
    border-radius: 12px;
    background: var(--a-chip);
  }

  .inv b {
    display: block;
    font-size: 11.5px;
  }

  .inv small {
    color: var(--a-muted);
    font-size: 9.5px;
  }

  .toggle {
    position: relative;
    flex: none;
    width: 30px;
    height: 17px;
    border-radius: 99px;
    background: var(--product-fibi);
  }

  .toggle::after {
    content: '';
    position: absolute;
    right: 2px;
    top: 2px;
    width: 13px;
    height: 13px;
    border-radius: 50%;
    background: #0c0c0d;
  }

  .actions {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 8px;
    margin-top: auto;
  }

  .actions span {
    display: grid;
    place-items: center;
    height: 40px;
    border-radius: 99px;
    font-size: 12.5px;
    font-weight: 600;
  }

  .ghost {
    background: var(--a-card);
  }

  .primary {
    background: var(--product-fibi);
    color: #0c0c0d;
    transition: transform 0.25s var(--spring);
  }

  .primary.on {
    transform: scale(0.94);
  }

  .hello {
    margin: 6px 0 12px;
  }

  .total {
    display: grid;
    gap: 6px;
    padding: 14px;
    border-radius: 18px;
    background: #141416;
    color: #f5f5f3;
  }

  .total .lbl {
    color: #9a9a9f;
  }

  .total b {
    font-size: 25px;
    letter-spacing: -0.03em;
  }

  .total em {
    font-style: normal;
    color: #8b8b90;
  }

  .list-h {
    margin: 16px 0 8px;
  }

  .rows {
    display: grid;
    gap: 2px;
    padding: 6px;
    border-radius: 18px;
    background: var(--a-card);
  }

  .row {
    display: grid;
    grid-template-columns: 30px 1fr auto;
    gap: 9px;
    align-items: center;
    padding: 7px 6px;
    border-radius: 12px;
    font-size: 12px;
  }

  .row small {
    display: block;
    color: var(--a-muted);
    font-size: 10px;
  }

  .ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--a-chip);
  }

  .ico svg {
    width: 15px;
    height: 15px;
    stroke: var(--a-fg);
  }

  .row.new {
    opacity: 0;
    transform: translateY(-10px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.55s var(--spring),
      background-color 1.2s var(--ease);
  }

  .row.new.on {
    opacity: 1;
    transform: none;
    background: color-mix(in srgb, var(--product-fibi) 26%, transparent);
  }

  .toast {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 64px;
    padding: 10px 12px;
    border-radius: 12px;
    background: #141416;
    color: #f5f5f3;
    font-size: 11px;
    text-align: center;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--spring);
  }

  .toast.on {
    opacity: 1;
    transform: none;
  }

  .tabbar {
    position: absolute;
    left: 10px;
    right: 10px;
    bottom: 10px;
    display: grid;
    grid-template-columns: repeat(2, 1fr) 40px repeat(2, 1fr);
    align-items: center;
    height: 46px;
    padding-inline: 4px;
    border-radius: 99px;
    background: var(--a-card);
  }

  .tabbar i {
    display: grid;
    justify-items: center;
    gap: 2px;
    min-width: 0;
    font-style: normal;
    font-size: 6.5px;
    line-height: 1;
    white-space: nowrap;
    color: var(--a-muted);
  }

  .tabbar svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tabbar .pill {
    display: grid;
    place-items: center;
    padding: 2px 8px;
    border-radius: 99px;
  }

  .tabbar .cur {
    color: var(--a-fg);
  }

  .tabbar .cur .pill {
    background: var(--a-chip);
  }

  .tabbar .cur svg {
    stroke-width: 2;
  }

  .tabbar .m {
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--product-fibi);
    color: #18181b;
  }

  .tabbar .m svg {
    width: 16px;
    height: 16px;
    stroke-width: 2;
  }

  .panel {
    position: relative;
    width: min(100%, 560px);
    padding: 18px 20px 16px;
    background: var(--card);
    border: 1px solid var(--line);
    transition: background-color 0.6s var(--ease);
  }

  .req {
    margin-bottom: 14px;
    font-size: 0.6875rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .req b {
    color: var(--fg);
    font-weight: 400;
  }

  .panel ul {
    display: grid;
  }

  .panel li {
    display: grid;
    grid-template-columns: minmax(0, 8.5rem) minmax(0, 1fr) 6rem;
    gap: 14px;
    align-items: center;
    padding-block: 9px;
    border-top: 1px solid var(--line);
    font-size: 0.875rem;
  }

  .track {
    height: 2px;
    background: var(--line);
    overflow: hidden;
  }

  .track i {
    display: block;
    height: 100%;
    background: var(--fg);
    transform: scaleX(0);
    transform-origin: left;
  }

  .val {
    position: relative;
    font-size: 0.75rem;
    text-align: right;
  }

  .wait,
  .got {
    transition: opacity 0.25s;
  }

  .got {
    position: absolute;
    right: 0;
    opacity: 0;
  }

  .wait {
    color: var(--muted);
  }

  .on .wait {
    opacity: 0;
  }

  .on .got {
    opacity: 1;
  }

  .on .track i {
    transform: scaleX(1);
    transition: transform 0.4s var(--ease);
  }

  .best .got::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin-right: 7px;
    border-radius: 50%;
    background: var(--fg);
    vertical-align: 1px;
  }

  .foot {
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--fg);
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity 0.4s;
  }

  .foot.on {
    opacity: 1;
  }

  @media (max-width: 539px) {
    .panel li {
      grid-template-columns: minmax(0, 1fr) 6rem;
    }

    .track {
      display: none;
    }
  }

  .pair {
    position: relative;
    display: grid;
    gap: 20px;
    width: min(100%, 560px);
  }

  .json {
    display: grid;
    margin: 0;
    padding: 16px 18px;
    background: var(--card);
    border: 1px solid var(--line);
    font-size: 0.75rem;
    line-height: 1.7;
    white-space: pre;
    overflow-x: auto;
    transition: background-color 0.6s var(--ease);
  }

  .json .op {
    color: var(--muted);
    transition:
      color 0.3s,
      background-color 0.3s;
  }

  .json .op.on {
    color: var(--fg);
    background: var(--surface);
  }

  .tv {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3px;
    aspect-ratio: 16 / 9;
    padding: 3px;
    background: #0c0c0d;
    border: 10px solid #0c0c0d;
    border-radius: 6px;
    box-shadow: 0 40px 70px -40px rgb(0 0 0 / 0.55);
  }

  .col {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 12px;
    background: #f5f5f3;
    color: #151517;
  }

  .col + .col {
    background: #151517;
    color: #f5f5f3;
  }

  .col h4 {
    margin-bottom: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .o {
    font-size: clamp(1.25rem, 0.8rem + 1.4vw, 1.875rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .o.in {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--spring);
  }

  .o.in.on {
    opacity: 1;
    transform: none;
  }

  .o.out {
    height: 1em;
    overflow: hidden;
    transition:
      opacity 0.3s,
      height 0.4s 0.25s var(--ease),
      margin 0.4s 0.25s var(--ease);
  }

  .o.out.on {
    opacity: 0;
    height: 0;
    margin-bottom: -6px;
  }

  .w-tok {
    --a-bg: #f7f7f5;
    --a-card: #ffffff;
    --a-fg: #15151a;
    --a-muted: #6b6f78;
    --a-line: rgb(21 21 26 / 0.12);
    --a-chip: #f0f0ee;
    --acc: #16744d;
  }

  .m-tok {
    --a-bg: #f7f7f5;
    --a-card: #ffffff;
    --a-fg: #18181b;
    --a-muted: #52525b;
    --a-line: #e3e3df;
    --a-chip: #efefec;
    --acc: #ea580c;
    --ok: #15803d;
  }

  :global(:root[data-theme='dark']) .w-tok {
    --a-bg: #0f0f13;
    --a-card: #1a1a22;
    --a-fg: #e8e8f0;
    --a-muted: #7a7f8c;
    --a-line: rgb(232 232 240 / 0.1);
    --a-chip: #24242f;
    --acc: #1f8a5f;
  }

  :global(:root[data-theme='dark']) .m-tok {
    --a-bg: #0c0c0d;
    --a-card: #161618;
    --a-fg: #fafafa;
    --a-muted: #a1a1aa;
    --a-line: #2c2c30;
    --a-chip: #1f1f22;
    --acc: #fb923c;
    --ok: #4ade80;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .w-tok {
      --a-bg: #0f0f13;
      --a-card: #1a1a22;
      --a-fg: #e8e8f0;
      --a-muted: #7a7f8c;
      --a-line: rgb(232 232 240 / 0.1);
      --a-chip: #24242f;
      --acc: #1f8a5f;
    }

    :global(:root:not([data-theme='light'])) .m-tok {
      --a-bg: #0c0c0d;
      --a-card: #161618;
      --a-fg: #fafafa;
      --a-muted: #a1a1aa;
      --a-line: #2c2c30;
      --a-chip: #1f1f22;
      --acc: #fb923c;
      --ok: #4ade80;
    }
  }

  .w-h {
    margin-top: 10px;
  }

  .w-mic {
    position: relative;
    display: grid;
    place-items: center;
    width: 112px;
    height: 112px;
    margin: 48px auto 28px;
  }

  .w-mic > span {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    background: var(--acc);
  }

  .w-mic svg,
  .w-fab svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: #fff;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  .w-mic rect,
  .w-fab rect {
    fill: #fff;
    stroke: none;
  }

  .w-ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1.5px solid var(--acc);
    opacity: 0;
  }

  .scr.on .w-ring {
    animation: listen 1.6s var(--ease) infinite;
  }

  .scr.on .w-r2 {
    animation-delay: 0.8s;
  }

  .w-fields {
    display: grid;
    gap: 8px;
    margin-top: 24px;
  }

  .w-field {
    display: grid;
    gap: 3px;
    padding: 12px 14px;
    border-radius: 14px;
    background: var(--a-card);
    border: 1px solid var(--a-line);
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 0.35s var(--ease),
      transform 0.5s var(--spring);
  }

  .w-field.on {
    opacity: 1;
    transform: none;
  }

  .w-field small {
    color: var(--a-muted);
    font-size: 9.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .w-field b {
    font-size: 15px;
    font-weight: 600;
  }

  .w-intent {
    margin-top: auto;
    padding-bottom: 6px;
    text-align: center;
    color: var(--acc);
    font-size: 10px;
    opacity: 0;
    transition: opacity 0.4s var(--ease);
  }

  .w-intent.on {
    opacity: 1;
  }

  .w-title {
    margin: 6px 0 14px;
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .w-list {
    display: grid;
    gap: 7px;
    margin-top: 8px;
  }

  .w-task {
    display: grid;
    grid-template-columns: 16px 1fr;
    gap: 10px;
    align-items: start;
    padding: 11px 12px;
    border-radius: 16px;
    background: var(--a-card);
    font-size: 12.5px;
  }

  .w-task small {
    display: block;
    margin-top: 2px;
    color: var(--a-muted);
    font-size: 10px;
  }

  .w-task .w-when {
    color: var(--acc);
  }

  .w-check {
    width: 15px;
    height: 15px;
    margin-top: 1px;
    border: 1.5px solid var(--a-muted);
    border-radius: 5px;
  }

  .w-subtask {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 9px;
    padding-top: 8px;
    border-top: 1px solid var(--a-line);
    color: var(--a-muted);
    font-size: 11.5px;
  }

  .w-subtask .w-check {
    width: 12px;
    height: 12px;
    margin: 0;
    border-radius: 4px;
  }

  .w-new {
    opacity: 0;
    transform: translateY(-10px);
    box-shadow: inset 0 0 0 1.5px transparent;
    transition:
      opacity 0.4s var(--ease),
      transform 0.55s var(--spring),
      box-shadow 1.2s var(--ease);
  }

  .w-new.on {
    opacity: 1;
    transform: none;
    box-shadow: inset 0 0 0 1.5px var(--acc);
  }

  .w-toast {
    position: absolute;
    left: 16px;
    right: 74px;
    bottom: 22px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 42px;
    padding-inline: 14px;
    border-radius: 14px;
    background: #15151a;
    color: #f2f2f0;
    font-size: 11.5px;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s var(--ease),
      transform 0.45s var(--spring);
  }

  .w-toast b {
    color: #3db87a;
    font-weight: 600;
  }

  .w-toast.on {
    opacity: 1;
    transform: none;
  }

  .w-fab {
    position: absolute;
    right: 16px;
    bottom: 18px;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--acc);
  }

  .w-fab svg {
    width: 20px;
    height: 20px;
  }

  .m-date {
    color: var(--a-muted);
    font-size: 9.5px;
    letter-spacing: 0.08em;
  }

  .m-title {
    margin: 2px 0 14px;
    font-size: 25px;
    font-weight: 700;
    letter-spacing: -0.03em;
  }

  .m-clock {
    display: grid;
    margin-top: 40px;
    text-align: center;
    font-size: 44px;
    font-weight: 300;
    letter-spacing: -0.02em;
  }

  .m-clock span {
    grid-area: 1 / 1;
