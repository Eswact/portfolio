<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const demos = document.querySelectorAll<HTMLElement>('[data-demo]');

  function run(root: HTMLElement) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-at]')];
    const rest = steps.filter((el) => el.classList.contains('on'));
    const cycle = Number(root.dataset.cycle);
    let timers: number[] = [];
    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));
    const play = () => {
      steps.forEach((el) => el.classList.remove('on'));
      steps.forEach((el) => {
        later(Number(el.dataset.at), () => el.classList.add('on'));
        if (el.dataset.off) later(Number(el.dataset.off), () => el.classList.remove('on'));
      });
      later(cycle, play);
    };
    const stop = () => {
      timers.forEach(clearTimeout);
      timers = [];
      steps.forEach((el) => el.classList.toggle('on', rest.includes(el)));
    };
    return { play, stop };
  }

  if (!reduce.matches && 'IntersectionObserver' in window) {
    demos.forEach((root) => {
      const timeline = run(root);
      new IntersectionObserver(([entry]) => (entry.isIntersecting ? timeline.play() : timeline.stop()), {
        threshold: 0.2,
      }).observe(root);
    });
  }
</script>

